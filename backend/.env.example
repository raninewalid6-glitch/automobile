# Copie ce fichier en ".env" et remplis les valeurs (ne jamais commiter .env)

# Chaîne de connexion Neon (console.neon.tech -> ton projet -> Connect -> Connection string)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Secret pour signer les tokens JWT (mets une longue chaîne aléatoire)
JWT_SECRET=change-moi-avec-une-longue-chaine-aleatoire
JWT_EXPIRES_IN=7d

# Port du serveur API
PORT=5000

# Origine autorisée (le frontend Vite)
CORS_ORIGIN=http://localhost:5173

# Compte SUPERADMIN créé par "npm run seed:admin"
ADMIN_EMAIL=admin@djibdrive.com
ADMIN_PASSWORD=admin123
ADMIN_NAME=Super Admin
